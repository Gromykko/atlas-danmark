---
import Base from "../layouts/Base.astro";
import "../styles/plate.css";
import { atlas } from "../data/atlas.ts";
import { isProvisional, type Confidence, type Text } from "../data/schema.ts";
import { audit, columnOf, plate, themeOf } from "../data/derived.ts";
import { cardHeight, titleLines } from "../data/layout.ts";

// Reader-visible chrome. The dataset is bilingual by type; these strings are
// the UI's own and were the only place English leaked into the Danish view.
const CONFIDENCE: Record<Confidence, Text> = {
  established: { en: "established", da: "veletableret" },
  sourced: { en: "sourced", da: "kildebelagt" },
  contested: { en: "contested", da: "omstridt" },
  legendary: { en: "legendary", da: "sagnstof" }
};
const UI = {
  provisional: { en: "provisional — Wikipedia only", da: "foreløbig — kun Wikipedia" },
  unverified: { en: "unverified", da: "ikke verificeret" }
};

// The plate: time runs down, themes run across in columns. One screen-sized
// object you read like a map, not a list you scroll through. Geometry comes
// from plate() — the same function the build gate proves has no overlaps.
const { minYear, maxYear } = atlas.meta;
const { events, scale, placed, height } = plate();
const colIndex = new Map(atlas.columns.map((c, i) => [c.id, i]));
const linked = new Set(atlas.links.flatMap((l) => [l.from, l.to]));
const byId = new Map(events.map((e) => [e.id, e]));
const a = audit();

// A century, measured in each band's own pixels. The axis used to print the
// span — "360 yr" — which makes the compression *recoverable by division*
// rather than visible. A scale bar is how every printed atlas since Ortelius
// discloses a projection that is not uniform.
const centuryBar = (from: number) => {
  const b = scale.bands.find((x) => from >= x.from && from < x.to) ?? scale.bands[0];
  return Math.round(100 * b.rate);
};
---

<Base
  title="Atlas Danmark · 690–2026"
  description="Et kildebelagt historisk atlas over Danmark, 690–2026. Hvert nedslag oplyser sit belæg, og omstridt historie vises som omstridt."
>
  <header>
    <h1>
      Atlas Danmark
      <small>{minYear}–{maxYear}</small>
    </h1>
    <p class="lede">
      <span class="en"
        >{events.length} sourced records. Contested history is shown with both readings — never one
        national story quietly chosen.</span
      >
      <span class="da"
        >{events.length} kildebelagte nedslag. Omstridt historie vises med begge læsninger — aldrig
        én national fortælling valgt i stilhed.</span
      >
    </p>

    {/* The audit ran every build and was thrown away into a console. These are
        the least flattering facts about the atlas, which is why they belong on
        the page: a reference work that publishes its own weakest measurement is
        making a claim the reader can check. */}
    <p class="audit">
      <span class="en">
        <b>{a.wikipediaOnly}</b>{" "}records rest on Wikipedia alone · <b>{a.singleSource}</b>{" "}of{" "}
        {a.events} rest on a single citation · <b>{a.topHostShare}%</b>{" "}of {a.urls} source URLs are{" "}
        {a.topHost} · <b>{a.contestedOneSource}</b>{" "}of {a.contested} contested records cite one work
        for both readings. This atlas is an index into the scholarship, not a substitute for it.
      </span>
      <span class="da">
        <b>{a.wikipediaOnly}</b>{" "}nedslag hviler alene på Wikipedia · <b>{a.singleSource}</b>{" "}af{" "}
        {a.events} hviler på én enkelt kilde · <b>{a.topHostShare}%</b>{" "}af {a.urls} kilde-URL'er er{" "}
        {a.topHost} · <b>{a.contestedOneSource}</b>{" "}af {a.contested} omstridte nedslag henviser til ét
        værk for begge læsninger. Dette atlas er en indgang til forskningen, ikke en erstatning for den.
      </span>
    </p>

    <div class="controls">
      <button data-lang-toggle type="button">
        <span class="en">Dansk</span><span class="da">English</span>
      </button>
      <a class="play" href="/spil/">
        <span class="en">Play the time machine →</span>
        <span class="da">Spil tidsmaskinen →</span>
      </a>
      <label class="filter">
        <span class="en">Show</span><span class="da">Vis</span>
        <select id="filter">
          <option value="" data-en="Everything" data-da="Alt">Alt</option>
          <optgroup label="Evidence / Belæg" data-en="Evidence" data-da="Belæg">
            <option value="conf:contested" data-en="Contested — two readings" data-da="Omstridt — to læsninger">Omstridt — to læsninger</option>
            <option value="conf:legendary" data-en="Legendary" data-da="Sagnstof">Sagnstof</option>
            <option value="conf:sourced" data-en="Sourced, not cross-checked" data-da="Kildebelagt, ikke efterprøvet">Kildebelagt, ikke efterprøvet</option>
            <option value="prov:1" data-en="Provisional — Wikipedia only" data-da="Foreløbig — kun Wikipedia">Foreløbig — kun Wikipedia</option>
          </optgroup>
          <optgroup label="Theme / Tema" data-en="Theme" data-da="Tema">
            {
              atlas.themes.map((t) => (
                <option value={`theme:${t.id}`} data-en={t.name.en} data-da={t.name.da}>
                  {t.name.da}
                </option>
              ))
            }
          </optgroup>
        </select>
      </label>
      <label class="filter search">
        <span class="en">Find</span><span class="da">Søg</span>
        <input id="q" type="search" autocomplete="off"
          data-en="title, place, or word" data-da="titel, sted eller ord" />
      </label>
      <output id="count" aria-live="polite" class="count"></output>
    </div>

    {/* An atlas without a key is not an atlas. Native <details>: correct
        keyboard semantics, no JS, and it prints. */}
    <details class="legend">
      <summary>
        <span class="en">How to read this plate</span><span class="da">Sådan læses pladen</span>
      </summary>
      <div class="legend-body">
        <section>
          <h2><span class="en">Evidence</span><span class="da">Belæg</span></h2>
          {/* The rule down the edge of a card breaks up as the evidence thins.
              Priestley drew uncertain dates as dotted line-ends in 1769 and
              wrote that a solid line there would be a lie. */}
          <ul class="key">
            <li><i class="sw"></i><span class="en"><b>Unbroken:</b> established — uncontested in the literature</span><span class="da"><b>Ubrudt:</b> fastslået — ubestridt i litteraturen</span></li>
            <li><i class="sw c-sourced"></i><span class="en"><b>Long dash:</b> sourced, but not independently cross-checked here</span><span class="da"><b>Lange streger:</b> kildebelagt, men ikke efterprøvet uafhængigt her</span></li>
            <li><i class="sw c-contested"></i><span class="en"><b>Short dash:</b> specialists genuinely disagree. Both readings are given, marked <b class="g">‡</b></span><span class="da"><b>Korte streger:</b> forskerne er reelt uenige. Begge læsninger vises, markeret <b class="g">‡</b></span></li>
            <li><i class="sw c-legendary"></i><span class="en"><b>Dotted:</b> a story the culture tells, not presented as fact, marked <b class="g">?</b></span><span class="da"><b>Prikket:</b> en fortælling kulturen bærer, ikke fremstillet som kendsgerning, markeret <b class="g">?</b></span></li>
            <li><i class="sw prov"></i><span class="en">Red marks a record resting on Wikipedia alone, or a source we could not open</span><span class="da">Rødt markerer et nedslag, der alene hviler på Wikipedia, eller en kilde vi ikke kunne åbne</span></li>
          </ul>
        </section>
        <section>
          <h2><span class="en">The plate</span><span class="da">Pladen</span></h2>
          <ul class="key">
            <li><i class="sw colour"></i><span class="en">The coloured edge is the theme — {atlas.themes.length} themes gathered into {atlas.columns.length} columns, so one column holds two or three colours</span><span class="da">Den farvede kant er temaet — {atlas.themes.length} temaer samlet i {atlas.columns.length} spalter, så én spalte rummer to-tre farver</span></li>
            <li><i class="sw bar"></i><span class="en">A vertical bar means the event has a duration; the bar spans it</span><span class="da">En lodret bjælke betyder, at nedslaget har en varighed; bjælken dækker den</span></li>
            <li><i class="sw lead"></i><span class="en">A dotted leader means the card was pushed below its true year to clear the card above. The tick marks the real date</span><span class="da">En prikket henvisningslinje betyder, at kortet er skubbet ned under sit rigtige årstal for at gå fri af kortet ovenfor. Mærket viser den rigtige dato</span></li>
            <li><i class="sw-grat"></i><span class="en">One faint rule is <b>10 years</b>. The rules crowd where the record is thin and open out where it is dense — the two samples here are the same decade at two different rates. An empty stretch of column is a finding, not a gap to be filled</span><span class="da">Én svag streg er <b>10 år</b>. Stregerne står tæt, hvor kilderne er tynde, og åbner sig, hvor de er tætte — de to prøver her er samme årti i to forskellige målestokke. En tom strækning i en spalte er et fund, ikke et hul der skal fyldes</span></li>
          </ul>
        </section>
        <section>
          <h2><span class="en">The vertical scale is not linear</span><span class="da">Den lodrette skala er ikke lineær</span></h2>
          <p>
            <span class="en"
              >The record is thin across 360 Viking years and thick across the 1940s alone, so each
              decade gets whichever is larger: the room its duration implies, or the room its
              densest column needs. Each era band carries a bar showing what 100 years measures
              <em>there</em> — compare them and the compression is visible rather than inferred.
              Periods themselves are conventions, not facts; the atlas argues this with itself at
              <a href="#lindisfarne">793</a>.</span
            >
            <span class="da"
              >Kildematerialet er tyndt gennem 360 vikingeår og tykt alene gennem 1940'erne, så hvert
              årti får det største af to mål: den plads dets varighed tilsiger, eller den plads dets
              tætteste spalte kræver. Hvert tidsbånd bærer en streg, der viser, hvad 100 år måler
              <em>dér</em> — sammenlign dem, og sammentrykningen bliver synlig i stedet for udledt.
              Selve periodeinddelingen er en konvention, ikke en kendsgerning; atlasset strides med
              sig selv om det ved <a href="#lindisfarne">793</a>.</span
            >
          </p>
        </section>
      </div>
    </details>
  </header>

  <main id="plate" class="plate-scroll">
    <div class="plate" style={`--h:${height}px; --cols:${atlas.columns.length}`}>
      {/* Readable, not hidden: the era names and their spans are the only
          period context a screen-reader user gets, since a card announces its
          year but not which age that year falls in. */}
      <div class="axis" aria-label="Eras / Perioder">
        {
          atlas.eras.map((era) => (
            <div class="era" style={`top:${scale.y(era.from)}px; height:${scale.y(era.to) - scale.y(era.from)}px`}>
              <b>{era.from}</b>
              <span class="en">{era.name.en}</span>
              <span class="da">{era.name.da}</span>
              {/* The scale bar: 100 years drawn at THIS band's rate. */}
              <i class="scalebar" style={`--bar:${centuryBar(era.from)}px`}>
                <span class="en">100 yr</span><span class="da">100 år</span>
              </i>
            </div>
          ))
        }
      </div>

      <div class="plate-body">
        <div class="columns">
          {
            atlas.columns.map((c) => (
              <div class="colhead">
                <span class="en">{c.name.en}</span>
                <span class="da">{c.name.da}</span>
              </div>
            ))
          }
        </div>

        <div class="field">
          {/* The graticule: one faint rule per decade, drawn at each band's own
              rate. Because the scale is piecewise the rules crowd through the
              thin Viking record and open out across the 1940s, so the reader
              watches the compression happen instead of being told about it. */}
          <div class="graticule" aria-hidden="true">
            {
              atlas.eras.map((era) => (
                <div
                  class="band"
                  style={`top:${scale.y(era.from)}px; height:${scale.y(era.to) - scale.y(era.from)}px; --yrs:${era.to - era.from}`}
                />
              ))
            }
          </div>
          {
            events.map((e) => {
              const t = themeOf(e);
              const col = colIndex.get(columnOf(e))!;
              const { top, offset } = placed.get(e.id)!;
              const span = e.endYear ? scale.y(e.endYear) - scale.y(e.year) : 0;
              const yr = `${e.yearApproximate ? "c. " : ""}${e.year}${e.endYear ? `–${e.endYear}` : ""}`;
              const yrDa = `${e.yearApproximate ? "ca. " : ""}${e.year}${e.endYear ? `–${e.endYear}` : ""}`;
              return (
                <article
                  class="ev"
                  id={e.id}
                  data-theme={e.theme}
                  data-conf={e.confidence}
                  data-prov={isProvisional(e) ? "1" : null}
                  data-id={e.id}
                  data-find={`${e.title.en} ${e.title.da} ${e.summary.en} ${e.summary.da} ${e.place ?? ""} ${t.name.en} ${t.name.da}`.toLowerCase()}
                  style={`top:${top}px; --col:${col}; --span:${span}px; --off:${offset}px; --c:${t.color}; --card:${cardHeight(e.title)}px; --lines:${titleLines(e.title)}`}
                >
                  {offset > 2 && <i class="leader" aria-hidden="true" />}
                  {span > 0 && <i class="span" aria-hidden="true" />}
                  {/* The accessible name carries what the borders and the colour
                      say to a sighted reader: theme and confidence. Both
                      languages are emitted as data and swapped by the toggle,
                      because an element cannot hold two aria-labels. */}
                  <button
                    type="button"
                    class={`marker c-${e.confidence}`}
                    aria-haspopup="dialog"
                    data-en={`${yr} — ${e.title.en} — ${t.name.en} — ${CONFIDENCE[e.confidence].en}`}
                    data-da={`${yrDa} — ${e.title.da} — ${t.name.da} — ${CONFIDENCE[e.confidence].da}`}
                  >
                    <span class="yr" aria-hidden="true">
                      {/* "c." and "ca." are the English and Danish conventions
                          for an uncertain date — rule 5 is reader-visible in
                          whichever language the reader is actually in. */}
                      {e.yearApproximate && <span class="en">c. </span>}
                      {e.yearApproximate && <span class="da">ca. </span>}
                      {e.year}
                      {e.endYear && `–${e.endYear}`}
                    </span>
                    <span class="ttl en" aria-hidden="true">{e.title.en}</span>
                    <span class="ttl da" aria-hidden="true">{e.title.da}</span>
                    <span class="theme-tag" aria-hidden="true">
                      <span class="en">{t.name.en}</span><span class="da">{t.name.da}</span>
                    </span>
                    {/* The apparatus criticus double dagger — the mark a
                        critical edition uses for a variant reading. */}
                    {e.confidence === "contested" && <em class="flag" aria-hidden="true">‡</em>}
                    {e.confidence === "legendary" && <em class="flag" aria-hidden="true">?</em>}
                  </button>
                  <template>
                    <b class="folio">
                      {e.yearApproximate && <span class="en">c. </span>}
                      {e.yearApproximate && <span class="da">ca. </span>}
                      {e.year}
                      {e.endYear && `–${e.endYear}`}
                    </b>
                    <h2>
                      <span class="en">{e.title.en}</span>
                      <span class="da">{e.title.da}</span>
                    </h2>
                    <p class="meta">
                      <span class="chip" style={`--c:${t.color}`}>
                        <span class="en">{t.name.en}</span>
                        <span class="da">{t.name.da}</span>
                      </span>
                      <span class={`conf c-${e.confidence}`}>
                        <span class="en">{CONFIDENCE[e.confidence].en}</span>
                        <span class="da">{CONFIDENCE[e.confidence].da}</span>
                      </span>
                      {e.place && <span class="place">{e.place}</span>}
                      {isProvisional(e) && (
                        <span class="prov">
                          <span class="en">{UI.provisional.en}</span>
                          <span class="da">{UI.provisional.da}</span>
                        </span>
                      )}
                    </p>
                    <p class="en">{e.summary.en}</p>
                    <p class="da">{e.summary.da}</p>
                    {e.detail && (
                      <>
                        <p class="en detail">{e.detail.en}</p>
                        <p class="da detail">{e.detail.da}</p>
                      </>
                    )}
                    {e.readings && (
                      <div class="readings">
                        {e.readings.map((r) => (
                          <blockquote>
                            <h3>
                              <span class="en">{r.side.en}</span>
                              <span class="da">{r.side.da}</span>
                            </h3>
                            <p class="en">{r.text.en}</p>
                            <p class="da">{r.text.da}</p>
                            <cite>{r.source}</cite>
                          </blockquote>
                        ))}
                      </div>
                    )}
                    {e.figures && (
                      <dl class="figures">
                        {e.figures.map((f) => (
                          <>
                            <dt>
                              <span class="en">{f.label.en}</span>
                              <span class="da">{f.label.da}</span>
                            </dt>
                            <dd>
                              <span class="en">{f.value.en}</span>
                              <span class="da">{f.value.da}</span>
                              {f.basis && (
                                <small>
                                  <span class="en">{f.basis.en}</span>
                                  <span class="da">{f.basis.da}</span>
                                </small>
                              )}
                              <cite>{f.source}</cite>
                            </dd>
                          </>
                        ))}
                      </dl>
                    )}
                    <footer>
                      <h3>
                        <span class="en">Sources</span><span class="da">Kilder</span>
                      </h3>
                      <ul>
                        {e.sources.map((s) => (
                          <li>
                            {s.url ? (
                              <a href={s.url} target="_blank" rel="noopener">
                                {s.label}
                              </a>
                            ) : (
                              s.label
                            )}
                            {s.unverified && (
                              <b class="unver">
                                <span class="en">{UI.unverified.en}</span>
                                <span class="da">{UI.unverified.da}</span>
                              </b>
                            )}
                          </li>
                        ))}
                      </ul>
                      {linked.has(e.id) && (
                        <p class="links">
                          {atlas.links
                            .filter((l) => l.from === e.id || l.to === e.id)
                            .map((l) => {
                              const otherId = l.from === e.id ? l.to : l.from;
                              const other = byId.get(otherId);
                              return (
                                <button type="button" class="rel" data-goto={otherId}>
                                  <span class="en">
                                    {l.from === e.id ? "→ " : "← "}
                                    {l.relation.en} <b>{other?.title.en ?? l.to}</b>
                                  </span>
                                  <span class="da">
                                    {l.from === e.id ? "→ " : "← "}
                                    {l.relation.da} <b>{other?.title.da ?? l.to}</b>
                                  </span>
                                </button>
                              );
                            })}
                        </p>
                      )}
                    </footer>
                  </template>
                </article>
              );
            })
          }
        </div>
      </div>
    </div>
  </main>

  <dialog id="panel">
    <form method="dialog">
      <button class="close">
        <span aria-hidden="true">×</span>
        <span class="vh en">Close</span><span class="vh da">Luk</span>
      </button>
    </form>
    <div id="panel-body"></div>
  </dialog>

  <script>
    const root = document.documentElement;
    const lang = () => root.dataset.lang ?? "da";

    // ponytail: detail HTML is pre-rendered into a <template> per event and
    // cloned on open. No client-side data layer, no serialisation step.
    const panel = document.getElementById("panel") as HTMLDialogElement;
    const panelBody = document.getElementById("panel-body")!;
    const cards = [...document.querySelectorAll<HTMLElement>(".ev")];

    // Marker names are bilingual data, applied on load and on every switch.
    const nameMarkers = () =>
      document
        .querySelectorAll<HTMLElement>(".marker")
        .forEach((b) => b.setAttribute("aria-label", b.dataset[lang()]!));
    nameMarkers();
    document.addEventListener("langchange", nameMarkers);

    function open(card: HTMLElement, push = true) {
      const tpl = card.querySelector("template")!;
      panelBody.replaceChildren(tpl.content.cloneNode(true));
      // The dialog announced as "dialog" — the <h2> is cloned in and has no id
      // to point aria-labelledby at, so name it from the marker instead.
      panel.setAttribute("aria-label", card.querySelector(".marker")!.getAttribute("aria-label")!);
      if (!panel.open) panel.showModal();
      // A record you cannot link to is a record nobody can cite or assign.
      if (push) history.replaceState(null, "", "#" + card.dataset.id);
    }

    cards.forEach((card) =>
      card.querySelector("button")!.addEventListener("click", () => open(card))
    );

    panel.addEventListener("close", () =>
      history.replaceState(null, "", location.pathname + location.search)
    );

    // The 47 documented relations were unclickable grey text at the bottom of a
    // panel. Following the chain is the thing a reader will actually do.
    panelBody.addEventListener("click", (ev) => {
      const to = (ev.target as HTMLElement).closest<HTMLElement>("[data-goto]")?.dataset.goto;
      const card = to && document.getElementById(to);
      if (!card) return;
      card.scrollIntoView({ block: "center" });
      open(card as HTMLElement);
    });

    const fromHash = () => {
      // `location.hash && getElementById(...)` yields "" with no hash, and
      // ""?.classList is undefined rather than nullish — so the optional chain
      // did not guard it and this threw on every ordinary page load, taking the
      // filter and search bindings below down with it.
      const card = location.hash ? document.getElementById(location.hash.slice(1)) : null;
      if (card?.classList.contains("ev")) {
        card.scrollIntoView({ block: "center" });
        open(card as HTMLElement, false);
      }
    };
    fromHash();
    addEventListener("hashchange", fromHash);

    // Filtering dims rather than removes: the shape of the plate — where the
    // record is thick and where it is thin — is itself information. Dimmed
    // cards are also made inert, so the filter filters for a screen reader too
    // instead of being a purely visual no-op.
    const filter = document.getElementById("filter") as HTMLSelectElement;
    const q = document.getElementById("q") as HTMLInputElement;
    const count = document.getElementById("count")!;

    function apply() {
      const [kind, val] = (filter.value || ":").split(":");
      const needle = q.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const passFilter =
          !filter.value ||
          (kind === "theme" && card.dataset.theme === val) ||
          (kind === "conf" && card.dataset.conf === val) ||
          (kind === "prov" && card.dataset.prov === "1");
        const passSearch = !needle || card.dataset.find!.includes(needle);
        const on = passFilter && passSearch;
        card.classList.toggle("dim", !on);
        card.inert = !on;
        if (on) shown++;
      }
      root.classList.toggle("filtering", !!filter.value || !!needle);
      count.textContent =
        shown === cards.length
          ? ""
          : lang() === "en"
            ? `${shown} of ${cards.length}`
            : `${shown} af ${cards.length}`;
    }
    filter.addEventListener("change", apply);
    q.addEventListener("input", apply);
    document.addEventListener("langchange", () => {
      q.placeholder = q.dataset[lang()]!;
      apply();
    });
    q.placeholder = q.dataset[lang()]!;
  </script>

</Base>
